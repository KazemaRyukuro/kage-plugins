{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KazemaRyukuro/kage-plugins/schema/index.schema.json",
  "title": "Kage-Plugin-Verzeichnis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "plugins", "revoked"],
  "properties": {
    "schema": { "const": 1 },
    "updated": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "kind", "description", "minKageVersion", "platforms", "permissions", "size", "sha256", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
          "name": { "type": "string" },
          "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
          "kind": { "enum": ["viewer", "panel", "tool", "engine"] },
          "description": { "type": "object", "required": ["de"], "properties": { "de": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": false },
          "minKageVersion": { "type": "string" },
          "platforms": { "type": "array", "items": { "enum": ["windows", "linux"] } },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "url": { "type": "string", "pattern": "^https://github\\.com/KazemaRyukuro/kage-plugins/releases/download/" }
        }
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versions", "reason"],
        "properties": {
          "id": { "type": "string" },
          "versions": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
